# `bun run dev:backend` writes these values when configuring Convex.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set the following on the Convex deployment using `bunx convex env set`.
# They are server credentials; never prefix them with NEXT_PUBLIC_.
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<random-secret-at-least-32-characters>
# GOOGLE_CLIENT_ID=<google-oauth-web-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth-web-client-secret>
# FACEBOOK_CLIENT_ID=<facebook-app-id>
# FACEBOOK_CLIENT_SECRET=<facebook-app-secret>

# Set these on Convex only after the actual onboarding notice is approved.
# Live answer storage and submission are blocked until all five are configured.
# ONBOARDING_PRIVACY_APPROVED=false
# ONBOARDING_PRIVACY_VERSION=<approved-notice-version>
# ONBOARDING_PRIVACY_TEXT=<approved-collection-use-and-storage-information>
# ONBOARDING_PRIVACY_CONTACT=<approved-privacy-contact>
# ONBOARDING_PRIVACY_RETENTION=<approved-retention-and-deletion-information>
